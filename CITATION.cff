cff-version: 1.2.0
title: "Adaptive Integration of Heterogeneous Peptide Representations for Antifungal Peptide Prediction"
message: "If you use TLH-AFP in your research, please cite this repository."
type: software

authors:
  - family-names: Mahmoudian
    given-names: Fatemeh
    affiliation: "Department of Computer Engineering, University of Qom, Qom, Iran"
